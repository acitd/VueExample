{
	"in_directory":"src",
	"out_directory":"public/cache/stylezero",
	"extensions":[".vue",".js"],
	"css_file":"public/assets/stylezero/global.css",
	"css_directory":"public/assets/stylezero",
	"js_directory":"public/assets/stylezero",
	"css_include":"<style scoped>@import'/assets/stylezero/STYLEZERO_ID.css';</style>\n",
	"js_include":"import zSTYLEZERO_ID from'/assets/stylezero/STYLEZERO_ID.js';\n",
	"replacements":{
		"<stylezero:id>":"STYLEZERO_ID",
		"<stylezero:time>":"STYLEZERO_TIME",
		"<stylezero:css>":"STYLEZERO_CSS_INCLUDE",
		"<stylezero:js>":"STYLEZERO_JS_INCLUDE"
	},
	"breakpoints":{
		"@small-only":"0-640",
		"@medium-only":"641-1024",
		"@medium":"641",
		"@large":"1025"
	}
}
